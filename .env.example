# Copy the names you need into .env (never commit real values).

# Supabase: Project settings → API keys. The secret key (or the legacy service-role key, as
# SUPABASE_SERVICE_ROLE_KEY) is server-only; never give it a NEXT_PUBLIC_ prefix.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=

# Signs the backroom's session cookie: 32+ random characters (`openssl rand -base64 48`).
# Changing it signs everyone out.
AUTH_SECRET=

# Direct Postgres access for `npm run db:migrate` / `npm run db:seed` (scripts/db.mts). The
# db.<ref>.supabase.co host is IPv6-only, so on IPv4 use the session pooler from the dashboard's
# "Connect" panel. The database itself is always `postgres`.
DB_PASSWORD=
DB_HOST=aws-1-<region>.pooler.supabase.com
DB_USER=postgres.<project-ref>

# Only for `npm run db:seed`, to create or reset a backroom account. Pass them on the command
# line rather than storing them here:
#   SEED_ADMIN_EMAIL=you@example.com SEED_ADMIN_PASSWORD='…' npm run db:seed
# SEED_ADMIN_NAME=
